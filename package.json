{
  "name": "dsh-bingo-ren",
  "version": "0.1.2",
  "description": "Draggable Bingo button for DeepSeek Harness: snaps to the nearest edge, restarts the whole desktop app in one click, and prompts when a new plugin is installed. Zero runtime dependencies.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "restart",
    "bingo",
    "plugin-manager",
    "desktop",
    "electron"
  ],
  "license": "MIT",
  "author": "Bingo Contributors",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "icon.svg",
    "assets"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongkongya367-glitch/dsh-bingo-ren.git"
  },
  "homepage": "https://github.com/kongkongya367-glitch/dsh-bingo-ren#readme",
  "bugs": {
    "url": "https://github.com/kongkongya367-glitch/dsh-bingo-ren/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node preview/build.mjs",
    "test": "node --test test/host.test.mjs test/restart-helper.test.mjs test/client-behavior.test.mjs test/install-local.test.mjs test/client-contract.mjs",
    "prepack": "npm run build"
  }
}
