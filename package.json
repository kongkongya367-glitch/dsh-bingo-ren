    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "restart",
    "bingo",
    "plugin-manager",
    "desktop",
    "electron"
  ],
  "license": "MIT",
  "author": "Bingo Contributors",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "icon.svg",
    "assets"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-name/dsh-bingo-ren.git"
  },
  "homepage": "https://github.com/your-name/dsh-bingo-ren#readme",
  "bugs": {
