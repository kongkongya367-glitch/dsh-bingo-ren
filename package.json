{
  "name": "dsh-bingo-ren",
  "version": "0.1.3",
  "description": "给 DeepSeek Harness 添加可拖动的 Bingo 按钮：一键重启桌面端，自动提醒新安装的插件，支持边缘吸附、位置记忆和深浅色主题。零运行时依赖，无遥测。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "restart",
    "bingo",
    "plugin-manager",
    "desktop",
    "electron",
    "重启",
    "插件",
    "插件提醒"
  ],
  "license": "MIT",
  "author": "Bingo Contributors",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.en.md",
    "LICENSE",
    "icon.svg",
    "assets"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongkongya367-glitch/dsh-bingo-ren.git"
  },
  "homepage": "https://github.com/kongkongya367-glitch/dsh-bingo-ren#readme",
  "bugs": {
    "url": "https://github.com/kongkongya367-glitch/dsh-bingo-ren/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node preview/build.mjs",
    "test": "node --test test/host.test.mjs test/restart-helper.test.mjs test/client-behavior.test.mjs test/install-local.test.mjs test/client-contract.mjs",
    "prepack": "npm run build"
  }
}
