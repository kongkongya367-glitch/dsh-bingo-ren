{
  "name": "dsh-bingo-ren",
  "version": "0.5.0",
  "description": "DeepSeek Harness 插件善后管家：重启提醒、变更记录、临时试用、启动验收、离线最小启动与恢复、可恢复的残留隔离清理、启动体检趋势。零运行时依赖，无遥测。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "restart",
    "bingo",
    "plugin-manager",
    "desktop",
    "electron",
    "重启",
    "插件",
    "插件提醒"
  ],
  "license": "MIT",
  "author": "Bingo Contributors",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "icon.svg",
    "assets"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongkongya367-glitch/dsh-bingo-ren.git"
  },
  "homepage": "https://github.com/kongkongya367-glitch/dsh-bingo-ren#readme",
  "bugs": {
    "url": "https://github.com/kongkongya367-glitch/dsh-bingo-ren/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node preview/build.mjs",
    "test": "node --test test/host.test.mjs test/activity.test.mjs test/recovery.test.mjs test/support.test.mjs test/timeline.test.mjs test/restart-helper.test.mjs test/client-behavior.test.mjs test/install-local.test.mjs test/client-contract.mjs",
    "test:smoke": "node test/smoke-real-profile.mjs",
    "prepack": "npm run build"
  },
  "bin": {
    "bingo-rescue": "lib/rescue-cli.mjs"
  }
}
